# === Telegram Push Notifications ===
# Create a bot: open Telegram → @BotFather → /newbot → copy the token here
TELEGRAM_BOT_TOKEN=
# Get your chat ID: message your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# === Search Preferences ===
ZIP_CODE=75022
MAX_PRICE=32000
SEARCH_RADIUS=100

# === Scan Intervals (minutes) ===
TESLA_SCAN_INTERVAL=5
THIRD_PARTY_SCAN_INTERVAL=15
DEALER_SCAN_INTERVAL=60

# === Optional: MarketCheck API (licensed inventory source) ===
# Never enter a key in the browser.
MARKETCHECK_API_KEY=
MARKETCHECK_RETENTION_AUTHORIZED=false

# === Server Settings ===
# Required when binding beyond localhost; choose a long random password.
TDH_PASSWORD=
TDH_HOST=127.0.0.1

# === Deal Alert Threshold ===
# Minimum deal score (0-100) to trigger a Telegram notification
DEAL_ALERT_THRESHOLD=70
